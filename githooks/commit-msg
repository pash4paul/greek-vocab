#!/usr/bin/env bash
# Git-хук: не пропускает сообщение коммита с кириллицей.
#
# В проекте вся переписка, комментарии и словарь по-русски, а история git —
# по-английски. Правило в CLAUDE.md соблюдается, только пока его помнят,
# поэтому здесь оно проверяется механически.
#
# Включается один раз на клон:
#   git config core.hooksPath githooks
#
# Разовый обход, если он зачем-то понадобился: git commit --no-verify

set -uo pipefail

msg_file="$1"

# Комментарии git всё равно вырежет — на них не смотрим.
found=$(python3 - "$msg_file" <<'PY'
import re, sys
lines = [l for l in open(sys.argv[1], encoding='utf-8') if not l.lstrip().startswith('#')]
# Внутри строки допускаем пробелы и пунктуацию, но не переводы строк —
# иначе в отчёт попадает половина сообщения.
hits = re.findall(r'[Ѐ-ӿ][Ѐ-ӿ \t\-,.:;()«»]*', ''.join(lines))
out = ' / '.join(h.strip() for h in hits[:3] if h.strip())
print(out[:90] + ('…' if len(out) > 90 else ''))
PY
)

if [ -n "$found" ]; then
  cat >&2 <<EOF

✗ Сообщение коммита содержит кириллицу.

  Найдено: ${found}

  В этом проекте история git ведётся на английском — см. CLAUDE.md.
  Комментарии в коде, документация и словарь остаются по-русски.

  Перепиши сообщение или, если это осознанное исключение,
  повтори с флагом --no-verify.

EOF
  exit 1
fi
