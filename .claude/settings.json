{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(npm run deck*)",
      "Bash(npm run test:morph*)",
      "Bash(npm run build*)",
      "Bash(npm run simulate*)",
      "Bash(npm run dev*)",
      "Bash(npm run fetch:cases*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/check-data.sh\"",
            "timeout": 60,
            "statusMessage": "Проверяю словарь"
          }
        ]
      }
    ]
  }
}
